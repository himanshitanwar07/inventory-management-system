# Rename this file to .env before running the project

# Port the Express server will run on
PORT=5000

# MongoDB connection string
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/inventory_db

# OR MongoDB Atlas (cloud) - replace with your own connection string:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/inventory_db
